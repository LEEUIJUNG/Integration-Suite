                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="SKST_009_OS2_DT">
                <xsd:sequence>
                    <xsd:element name="DATA">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="UPDATE_COUNT" type="xsd:string"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:schema>
    </wsdl:types>
    <wsdl:message name="SKST_009_OS1_MT">
        <wsdl:documentation/>
        <wsdl:part element="p1:SKST_009_OS1_MT" name="SKST_009_OS1_MT"/>
    </wsdl:message>
    <wsdl:message name="SKST_009_OS2_MT">
